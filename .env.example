# APP CONFIGURATION
PROJECT_NAME="Enterprise AI Research & Knowledge Assistant"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="enterprise_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DATABASE (SQLAlchemy Async)
# Local SQLite fallback default: sqlite+aiosqlite:///./ai_research.db
# PostgreSQL standard URI: postgresql+asyncpg://postgres:postgres@localhost:5432/ai_research_db
DATABASE_URL="sqlite+aiosqlite:///./ai_research.db"

# REDIS CACHE
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# VECTOR DATABASE (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION="enterprise_knowledge_chunks"
# Memory mode fallback for local execution when Qdrant server is not running
QDRANT_IN_MEMORY=true

# EMBEDDING & RAG
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
DEFAULT_TOP_K=5
RE_RANK_ENABLED=true

# LLM PROVIDERS
# Provider options: mock, openai, anthropic, gemini, ollama, deepseek, mistral
DEFAULT_LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-large-latest"

# TENSORFLOW DOCUMENT CLASSIFIER
TF_MODEL_DIR="./data/models/document_classifier"
AUTO_CLASSIFY_ON_UPLOAD=true

# RATE LIMITING
RATE_LIMIT_PER_MINUTE=100

# STORAGE
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=50
